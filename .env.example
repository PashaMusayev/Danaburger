# Admin panel. Real values go into Vercel → Settings → Environment Variables (see ADMIN.md).
# For local development copy this file to .env.local and run `npm run admin:mock` (a fake GitHub).

# npm run hash-password  → prints both lines below
ADMIN_PASSWORD_HASH=
SESSION_SECRET=

# Fine-grained token: this repository only, "Contents: Read and write"
GITHUB_TOKEN=mock-token
GITHUB_REPO=pashamusayev/danaburger
# Must be Vercel's Production Branch, otherwise published changes never reach the site
GITHUB_BRANCH=main

# Local only: point at the fake GitHub from `npm run admin:mock`. Leave unset in Vercel.
GITHUB_API_URL=http://localhost:4010
